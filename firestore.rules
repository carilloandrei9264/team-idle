rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasValidPublicMapLocation(data) {
      return !data.keys().hasAny(['mapLocation'])
        || data.mapLocation == null
        || (data.mapLocation is map
          && data.mapLocation.precision == 'approximate'
          && data.mapLocation.keys().hasOnly(['geohash', 'precision'])
          && data.mapLocation.geohash is string
          && data.mapLocation.geohash.matches('^[0123456789bcdefghjkmnpqrstuvwxyz]{5}$'));
    }

    function hasValidDocumentAsset(asset, listingId, kind, resourceTypes) {
      return asset is map
        && asset.keys().hasOnly(['publicId', 'format', 'resourceType'])
        && asset.publicId is string
        && asset.publicId.matches('^trusthome_private_' + listingId + '_' + kind + '_[A-Za-z0-9-]{36}$')
        && asset.format is string
        && asset.format.matches('^[A-Za-z0-9]{1,10}$')
        && asset.resourceType in resourceTypes;
    }

    function hasValidPrivateDocuments(data, listingId) {
      return !data.keys().hasAny(['documents'])
        || (data.documents is map
          && data.documents.keys().hasOnly(['ownership', 'govId'])
          && (!data.documents.keys().hasAny(['ownership'])
            || hasValidDocumentAsset(data.documents.ownership, listingId, 'ownership', ['image', 'raw']))
          && (!data.documents.keys().hasAny(['govId'])
            || hasValidDocumentAsset(data.documents.govId, listingId, 'govId', ['image', 'raw'])));
    }

    function hasNoLegacyPrivateDocumentUrls(data) {
      return !data.keys().hasAny(['ownershipDocumentUrl', 'governmentIdUrl']);
    }

    function hasRequiredPrivateDocumentsForPendingListing(data, listingId) {
      return getAfter(/databases/$(database)/documents/listings/$(listingId)).data.verificationStatus != 'pending'
        || (data.documents is map
          && data.documents.keys().hasAll(['ownership', 'govId'])
          && hasValidDocumentAsset(data.documents.ownership, listingId, 'ownership', ['image', 'raw'])
          && hasValidDocumentAsset(data.documents.govId, listingId, 'govId', ['image', 'raw']));
    }

    function hasNoPublicVerificationUrls(data) {
      return !data.keys().hasAny(['verificationDocUrl', 'ownershipDocumentUrl', 'governmentIdUrl']);
    }

    function hasValidListingPurpose(data) {
      return !data.keys().hasAny(['listingPurpose'])
        || (data.listingPurpose in ['rent', 'sale']
          && (data.listingPurpose == 'sale'
            ? data.rentalTerm == null
            : data.rentalTerm in ['short_term', 'long_term']));
    }

    function hasExplicitListingPurpose(data) {
      return data.keys().hasAny(['listingPurpose']) && hasValidListingPurpose(data);
    }

    // User profiles are private to the account owner and admins.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if false;
    }

    // Public users can read verified listings. Owners can read their own
    // listings, including pending and rejected submissions.
    match /listings/{listingId} {
      allow read: if resource.data.verificationStatus == 'verified'
        || isOwner(resource.data.ownerId)
        || isAdmin();

      allow create: if isActiveUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending'
        && !request.resource.data.keys().hasAny(['address'])
        && hasExplicitListingPurpose(request.resource.data)
        && hasNoPublicVerificationUrls(request.resource.data)
        && hasValidPublicMapLocation(request.resource.data);

      // Admins control verification fields. Owners may edit their own listing
      // fields and resubmit rejected listings, but cannot self-approve them.
      allow update: if isAdmin()
        || (isActiveUser()
          && isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && hasValidListingPurpose(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'type', 'listingPurpose', 'rentalTerm', 'city', 'price', 'pricePeriod', 'mapLocation',
            'bedrooms', 'bathrooms', 'floorArea', 'lotArea', 'availabilityDate',
            'amenities', 'showingWindows', 'photoUrls', 'verificationDocUrl',
            'ownershipDocumentUrl', 'governmentIdUrl', 'resubmissionRequested',
            'verificationStatus', 'updatedAt'
          ])
          && request.resource.data.verificationStatus == 'pending'
          && !request.resource.data.keys().hasAny(['address'])
          && hasNoPublicVerificationUrls(request.resource.data)
          && hasValidPublicMapLocation(request.resource.data));

      allow delete: if isAdmin()
        || (isActiveUser() && isOwner(resource.data.ownerId));
    }

    // Exact listing addresses are private. Public listing documents contain
    // only the owner's deliberately coarsened map location.
    match /listingPrivate/{listingId} {
      allow read: if isActiveUser()
        && (isAdmin() || isOwner(resource.data.ownerId));
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'address', 'documents', 'updatedAt'
        ])
        && hasValidPrivateDocuments(request.resource.data, listingId)
        && hasNoLegacyPrivateDocumentUrls(request.resource.data)
        && hasRequiredPrivateDocumentsForPendingListing(request.resource.data, listingId)
        && ((isOwner(request.resource.data.ownerId)
            && request.resource.data.address is string
            && request.resource.data.address.size() > 0
            && getAfter(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid)
          || (isAdmin()
            && request.resource.data.ownerId == get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId));
      allow update: if isAdmin()
        || (isActiveUser()
          && isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'address', 'documents', 'ownershipDocumentUrl', 'governmentIdUrl', 'updatedAt'
          ])
          && hasValidPrivateDocuments(request.resource.data, listingId)
          && hasNoLegacyPrivateDocumentUrls(request.resource.data)
          && (hasRequiredPrivateDocumentsForPendingListing(request.resource.data, listingId)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ownershipDocumentUrl', 'governmentIdUrl'
            ])
              && hasNoLegacyPrivateDocumentUrls(request.resource.data)))
          && request.resource.data.address is string
          && request.resource.data.address.size() > 0);
      allow delete: if isAdmin() || (isActiveUser() && isOwner(resource.data.ownerId));
    }

    // Public catalog data is readable only while active. Admins may inspect
    // delisted records as well.
    match /bankProperties/{propertyId} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isActiveUser()
        && (resource.data.renterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.renterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.startDate < request.resource.data.endDate
        && request.resource.data.listingId is string
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.verificationStatus == 'verified'
        && (!get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.keys().hasAny(['listingPurpose'])
          || get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.listingPurpose == 'rent')
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.ownerId;
      allow update: if isAdmin()
        || (isActiveUser() && resource.data.renterId == request.auth.uid
          && resource.data.status == 'Confirmed'
          && request.resource.data.status == 'Completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'completedAt', 'updatedAt'
          ]))
        || (isActiveUser() && resource.data.renterId == request.auth.uid
          && resource.data.status in ['Confirmed', 'Completed']
          && request.resource.data.status == 'Disputed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'disputedAt', 'disputeId', 'updatedAt'
          ]))
        || (isActiveUser() && resource.data.renterId == request.auth.uid
          && resource.data.status == 'Confirmed'
          && request.resource.data.status == 'Confirmed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['depositReference', 'updatedAt']));
      allow delete: if isActiveUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'Pending';
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isActiveUser()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.bookingId is string
        && ratingId == request.resource.data.bookingId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.renterId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'Completed'
        && request.resource.data.ownerId == get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerId
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 0;
      allow update, delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.raisedBy == request.auth.uid);
      allow create: if isActiveUser()
        && request.resource.data.raisedBy == request.auth.uid
        && request.resource.data.status == 'Open'
        && request.resource.data.bookingId is string
        && request.resource.data.ownerId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.renterId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status in ['Confirmed', 'Completed']
        && request.resource.data.ownerId == get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.ownerId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'Disputed'
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.disputeId == disputeId;
      allow update: if isAdmin()
        && request.resource.data.status in ['Founded', 'Dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolutionNotes', 'resolvedAt', 'resolvedBy'
        ]);
      allow delete: if false;
    }

    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isOwner(profileId) || isAdmin();
      allow delete: if false;
    }

    // Public count-only accountability summaries. Private dispute reports
    // remain readable only by the reporter and admins.
    match /publicAccountability/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /savedSearches/{searchId} {
      allow read, delete: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    function canAccessNotification(recipientId, type) {
      return isActiveUser()
        && ((isAdmin() && recipientId == '__admins__' && type in ['dispute_update', 'listing_submitted'])
          || (!isAdmin() && recipientId == request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow read: if canAccessNotification(resource.data.recipientId, resource.data.type);
      allow update: if canAccessNotification(resource.data.recipientId, resource.data.type)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if isActiveUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.read == false
        && ((isAdmin() && request.resource.data.recipientId != '__admins__')
          || (!isAdmin() && request.resource.data.recipientId == request.auth.uid)
          || (!isAdmin() && request.resource.data.entityType == 'booking'
            && request.resource.data.entityId is string
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.entityId)).data.renterId == request.auth.uid
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.entityId)).data.ownerId == request.resource.data.recipientId)
          || (!isAdmin() && request.resource.data.entityType == 'booking'
            && request.resource.data.entityId is string
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.entityId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.entityId)).data.renterId == request.resource.data.recipientId)
          || (!isAdmin() && request.resource.data.recipientId == '__admins__'
            && request.resource.data.type == 'listing_submitted'
            && request.resource.data.entityType == 'listing'
            && request.resource.data.entityId is string
            && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.entityId)).data.ownerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.entityId)).data.verificationStatus == 'pending')
          || (!isAdmin() && request.resource.data.recipientId == '__admins__'
            && request.resource.data.type == 'dispute_update'
            && request.resource.data.entityType == 'dispute'
            && request.resource.data.entityId is string
            && get(/databases/$(database)/documents/disputes/$(request.resource.data.entityId)).data.raisedBy == request.auth.uid
            && get(/databases/$(database)/documents/disputes/$(request.resource.data.entityId)).data.status == 'Open'));
      allow delete: if canAccessNotification(resource.data.recipientId, resource.data.type);
    }

    // Trust scores are public display data; only admins/functions should write.
    match /trustScores/{scoreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The admin UI queues scraper requests and reads their status.
    match /scraperJobs/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'queued';
      allow update, delete: if isAdmin();
    }

    // Admin dashboard reads.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
